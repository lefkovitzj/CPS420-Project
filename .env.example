# Application host and port configuration.
HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_PORT=3000

# PostgreSQL database (local development).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cps420
POSTGRES_USER=cps420
POSTGRES_PASSWORD=cps420-local-dev-password

# SeaweedFS S3 storage (local development).
SEAWEEDFS_S3_PORT=8333
AWS_ACCESS_KEY_ID=cps420-dev
AWS_SECRET_ACCESS_KEY=cps420-local-dev-secret
S3_BUCKET=cps420-uploads

# JWT signing secret (local development).
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-your-own

# Optional Fernet key for authenticator secrets. Keep it stable across deployments.
# If omitted, the encryption key is derived from JWT_SECRET.
MFA_ENCRYPTION_KEY=

# Set true when HTTPS terminates at a reverse proxy. Local HTTP uses false.
AUTH_COOKIE_SECURE=false
